{
  "manifest_version": 3,
  "name": "Antigravity Status Checker",
  "version": "1.0.0",
  "description": "Real-time connectivity and bypass status checker for Google Antigravity and Gemini AI services.",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*",
    "https://aistudio.google.com/*",
    "https://accounts.google.com/*",
    "https://gemini.google.com/*",
    "https://ipwho.is/*"
  ],
  "action": {
    "default_title": "Antigravity Status",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "service-worker.js"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
